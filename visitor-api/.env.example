# Existing shared API credentials. Server only; never compile into a website.
KV_REST_API_URL=https://YOUR_EXISTING_DATABASE.upstash.io
KV_REST_API_TOKEN=YOUR_EXISTING_SERVER_TOKEN
VISITOR_HASH_SALT=EXISTING_PORTFOLIO_SECRET_KEEP_UNCHANGED
GROQ_API_KEY=EXISTING_GUIDE_KEY_KEEP_UNCHANGED
GUIDE_RATE_SALT=EXISTING_GUIDE_SECRET_KEEP_UNCHANGED

# New per-project secret: generate once, retain across redeployments.
TRAFFIC_NO_BLOOM_HASH_SALT=GENERATE_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Explicit local enablement, effective only outside Vercel production.
TRAFFIC_ALLOW_LOCAL=false
# Owner's locally approved report projects. Does not grant Redis credentials.
TRAFFIC_REPORT_PROJECTS=no-bloom
